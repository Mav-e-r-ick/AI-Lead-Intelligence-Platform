# ============================================================================
# .env.example
# ============================================================================
# WHY THIS FILE EXISTS:
# Real secrets (API keys, passwords, database URLs) must NEVER be committed
# to git — anyone with repo access (or anyone who finds it on GitHub) would
# be able to steal them. The fix used by almost every production codebase:
#
#   1. This file (.env.example) is committed to git. It lists every setting
#      the app needs, with FAKE placeholder values, so a new developer knows
#      exactly what to configure.
#   2. Each developer copies it to a real ".env" file:
#         cp .env.example .env
#      and fills in their own real secrets.
#   3. ".env" is listed in .gitignore, so git ignores it and secrets never
#      get committed.
#
# Nothing in this file is wired up to code yet — this is foundation only.
# It exists so the folder structure (core/config.py) has something to point
# to when configuration is implemented in a later task.
# ============================================================================

# --- Application -----------------------------------------------------------
# Which environment is running: "development", "staging", or "production".
# Code can check this to decide things like "show detailed errors" (dev only).
APP_ENV=development

# How much detail should logs print? DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# A random secret string used later for signing things like session tokens.
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ----------------------------------------------------------
# Where the app's database lives. Postgres is recommended for production;
# SQLite is fine for local development because it needs no separate server.
# `docker-compose up postgres` starts a local Postgres matching this URL.
DATABASE_URL=postgresql+psycopg2://lead_intelligence:lead_intelligence@localhost:5432/lead_intelligence

# Connection pool tuning (Postgres only — SQLite ignores these). See
# core/config.py for what each one does; the defaults are fine for local
# development and a good starting point for a single production instance.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

# --- AI provider (for future outreach-message generation) ------------------
# Anthropic's Claude is the AI provider this project is built around.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Email verification (Contact Verification Framework) ------------------
# NeverBounce is this platform's first concrete email verification
# provider (infrastructure/external_services/email_verification/neverbounce/).
# Get a real key at https://app.neverbounce.com/settings/api . Without one,
# NeverBounceSettings.validate() raises immediately at construction time —
# it never silently sends unauthenticated requests.
NEVERBOUNCE_API_KEY=your-neverbounce-api-key-here

# --- Phone verification (for future contact-verification step) ------------
PHONE_VERIFICATION_API_KEY=your-phone-verification-api-key-here

# --- Google Custom Search credentials (Enrichment Provider Framework AND
# the Search Layer's Federated Search providers) --------------------------
# One Google Custom Search JSON API credential, shared by:
#   - GoogleSearchProvider (infrastructure/enrichment/google_search/) —
#     the Enrichment Provider Framework's own general web-evidence provider.
#   - GoogleSearchProvider, LinkedInSearchProvider, and NewsProvider
#     (infrastructure/search/google/, /linkedin/, /news/) — three of the
#     Search Layer's five Federated Search providers (see
#     application/search/README.md's "Federated Search" section). All
#     three call the same Google Custom Search API under this one
#     credential — LinkedInSearchProvider restricts its queries to
#     linkedin.com, NewsProvider to a fixed list of trusted news domains,
#     GoogleSearchProvider searches the general web.
# GOOGLE_SEARCH_API_KEY: an API key from https://console.cloud.google.com/apis/credentials
# GOOGLE_SEARCH_ENGINE_ID: a Programmable Search Engine id ("cx") from
# https://programmablesearchengine.google.com/. Without both, every one of
# these four providers' *Settings.validate() raises immediately at
# construction time — none of them silently send unauthenticated
# requests. run_pipeline.py's Search Layer wiring treats this credential
# as all-or-nothing for its three Google-backed providers: if it's unset,
# GoogleSearchProvider/LinkedInSearchProvider/NewsProvider are all skipped
# together, and CompanyCrawlerProvider/PressReleaseProvider (which need no
# configuration) still run alone — see run_pipeline.py's
# `_build_search_collaborators`.
GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id-here

# --- Browser Search provider (Search Layer — standalone, not part of the
# active Federated Search wiring) --------------------------------------
# BrowserSearchProvider (infrastructure/search/browser/) drives a real,
# headless browser against a search-results page you configure here, for
# search engines with no published API. As of the Federated Search
# redesign, run_pipeline.py's SearchCoordinator no longer registers this
# provider (GoogleSearchProvider/LinkedInSearchProvider/NewsProvider above
# cover that role instead) — its package, tests, and this configuration
# are kept for standalone use (see infrastructure/search/browser/README.md),
# not because a real run_pipeline.py invocation still reads it. There is
# deliberately NO default value for these four — YOU are responsible for
# confirming you are authorized to automate queries against whatever
# engine you point this at (terms of service, rate limits), and that its
# robots.txt allows the configured user agent to do so. Without all four,
# BrowserSearchProviderSettings.validate() raises immediately at
# construction time.
# BROWSER_SEARCH_URL_TEMPLATE: the results-page URL, with a literal
# "{query}" placeholder, e.g. "https://searx.example.org/search?q={query}".
# BROWSER_SEARCH_RESULT_SELECTOR / _TITLE_SELECTOR / _URL_SELECTOR: CSS
# selectors for one result item, its title text, and its link element —
# specific to whichever engine's results page you configure.
BROWSER_SEARCH_URL_TEMPLATE=https://searx.example.org/search?q={query}
BROWSER_SEARCH_RESULT_SELECTOR=div.result
BROWSER_SEARCH_TITLE_SELECTOR=h3
BROWSER_SEARCH_URL_SELECTOR=a
# Optional: a snippet-text CSS selector, evaluated within each result item.
BROWSER_SEARCH_SNIPPET_SELECTOR=p.content
# Optional: maximum result URLs collected per query (default: 10).
BROWSER_SEARCH_MAX_RESULTS=10
# Optional: "false" runs a visible (non-headless) browser, for local
# debugging only — always "true" (the default) in any real run.
BROWSER_SEARCH_HEADLESS=true
# Optional: explicit path to a Chromium executable, if Playwright's own
# browser-resolution logic doesn't find the one you have installed.
BROWSER_SEARCH_EXECUTABLE_PATH=

# --- Company / LinkedIn enrichment data (for future verification step) -----
LINKEDIN_DATA_API_KEY=your-linkedin-data-api-key-here
COMPANY_DATA_API_KEY=your-company-data-api-key-here

# --- Outbound email sending (for future "send emails" step) ----------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=outreach@yourcompany.com
