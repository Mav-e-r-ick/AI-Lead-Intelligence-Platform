# ============================================================================
# .gitignore
# ============================================================================
# WHY THIS FILE EXISTS:
# Git tracks every file in this folder unless we tell it not to. Some files
# should NEVER be committed to version control:
#   1. Secrets (API keys, passwords)       -> would leak credentials publicly
#   2. Generated files (caches, bytecode)  -> can always be regenerated
#   3. Personal environment files (venv)   -> different on every machine
#   4. Real data (Excel files with names,
#      emails, phone numbers of leads)     -> this is PII (Personally
#                                              Identifiable Information) and
#                                              must never end up in git history
# ============================================================================

# --- Secrets & environment -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Testing & coverage -----------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# --- Databases (local dev only) ----------------------------------------
*.db
*.sqlite3

# --- Logs -----------------------------------------------------------------
logs/*.log
*.log

# --- Sensitive lead/business data -------------------------------------
# Real spreadsheets contain executives' personal data. Only .gitkeep
# placeholder files are tracked so the folder structure survives in git,
# the actual data files never do.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# scripts/run_evaluation.py's CSV/JSON reports are generated from the same
# real executive data as data/raw/ and carry the same PII risk -- never
# committed, for the same reason.
reports/*
!reports/.gitkeep

# --- IDE / editor ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# --- OS files ------------------------------------------------------------
.DS_Store
Thumbs.db
