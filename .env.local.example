# ============================================================================
# .env.local.example
# ============================================================================
# WHY THIS FILE EXISTS, SEPARATE FROM .env.example:
# .env.example configures the whole application (database, API keys for
# every provider) and deliberately ships BROWSER_SEARCH_* with a generic,
# non-functional placeholder (searx.example.org) — no vendor is "the"
# default, because automating a browser against a real search engine's own
# web UI is a decision only the operator can make for that target (terms of
# service, rate limits; see infrastructure/search/browser/README.md).
#
# This file is specifically for running run_local.py / run_pipeline.py on a
# developer laptop with real internet access, and pre-fills
# BrowserSearchProvider with DuckDuckGo's HTML-only results endpoint
# (https://html.duckduckgo.com/html/) as a concrete, working starting point
# for local development and manual testing — not a production deployment
# default, and not wired into any other part of the platform.
#
# Copy this file to .env.local and load it (run_local.py does this
# automatically via python-dotenv; .env.local is gitignored, this
# .env.local.example file is not):
#     cp .env.local.example .env.local
#
# Nothing in this file is hardcoded into Python — every value here is read
# at runtime via BrowserSearchProviderSettings.from_env()
# (infrastructure/search/browser/settings.py). Change these values freely;
# no code changes are needed to point this at a different search engine.
# ============================================================================

# --- Browser Search provider (Search Layer) --------------------------------
# The results-page URL, with a literal "{query}" placeholder. DuckDuckGo's
# HTML-only endpoint renders results server-side (no JavaScript required),
# which makes it a stable target for CSS-selector-based extraction.
BROWSER_SEARCH_URL_TEMPLATE=https://html.duckduckgo.com/html/?q={query}

# CSS selectors for one result item, its title text + link, and its
# snippet, on DuckDuckGo's HTML results page. These reflect that page's
# long-stable markup at the time this file was written; DuckDuckGo can
# change its markup at any time without notice — if BrowserSearchProvider
# starts returning zero results against a real, allowed query, inspect the
# live page's DOM (browser dev tools) and update these selectors, per
# infrastructure/search/browser/README.md's "Testing against a real,
# authorized search engine" section.
BROWSER_SEARCH_RESULT_SELECTOR=.result
# The title and URL both live on the same anchor element (its visible text
# is the title; its href is the URL) — pointing both selectors at it is
# intentional, not a mistake.
BROWSER_SEARCH_TITLE_SELECTOR=.result__a
BROWSER_SEARCH_URL_SELECTOR=.result__a
BROWSER_SEARCH_SNIPPET_SELECTOR=.result__snippet

# Maximum result URLs collected per query.
BROWSER_SEARCH_MAX_RESULTS=10

# "false" runs a visible (non-headless) browser — useful the first time you
# run this locally, to actually watch it navigate and confirm the
# selectors above still match. Always "true" for any unattended run.
BROWSER_SEARCH_HEADLESS=true

# Optional: explicit path to a Chromium executable, only needed if
# `playwright install chromium` (see LOCAL_SETUP.md) didn't leave one where
# Playwright's own resolution logic expects it.
BROWSER_SEARCH_EXECUTABLE_PATH=

# Directory a query's rendered page HTML + a screenshot are saved to whenever
# that query's selectors yield zero results (page loaded, but nothing
# matched) — this is what lets you tell "the search engine changed its
# markup" apart from "the search engine served a bot-check/rate-limit page"
# after the fact, without re-running with a debugger attached. Blank
# disables saving.
BROWSER_SEARCH_DEBUG_DIR=browser_search_debug

# --- Development Mode (run_pipeline.py / run_local.py only) ----------------
# When "true", a provider failure that looks like a network/connectivity
# problem (a blocked outbound connection, DNS failure, or an HTTP 403 at
# the connection stage) does NOT count towards that provider's
# consecutive-failure streak, so ProviderHealthTracker's circuit breaker
# never trips from that class of failure alone. A provider that reaches
# the real destination and gets a genuine content-level failure (404, 500,
# a timeout after retries) is tracked exactly as before — Development Mode
# changes nothing about how real website failures are handled. Off by
# default; only affects run_pipeline.py/run_local.py, never
# scripts/run_evaluation.py or the orchestrator's own default behavior.
PIPELINE_DEV_MODE=true

# Where run_local.py / run_pipeline.py write results.xlsx,
# processing_report.json, and logs/, if you don't pass --output-dir.
PIPELINE_OUTPUT_DIR=run_output
