# ============================================================================
# .env.local.example
# ============================================================================
# WHY THIS FILE EXISTS, SEPARATE FROM .env.example:
# .env.example configures the whole application (database, API keys for
# every provider) and deliberately ships BROWSER_SEARCH_* with a generic,
# non-functional placeholder (searx.example.org) — no vendor is "the"
# default, because automating a browser against a real search engine's own
# web UI is a decision only the operator can make for that target (terms of
# service, rate limits; see infrastructure/search/browser/README.md).
#
# This file is specifically for running run_local.py / run_pipeline.py on a
# developer laptop with real internet access, and pre-fills
# BrowserSearchProvider to drive the operator's own, real Google Chrome
# (via Playwright's launch_persistent_context() against that Chrome's real
# profile — cookies, history, signed-in sessions included) against Google's
# results page — not a production deployment default, and not wired into
# any other part of the platform.
#
# As of the Federated Search redesign, run_pipeline.py's SearchCoordinator
# no longer registers BrowserSearchProvider at all — CompanyCrawlerProvider,
# GoogleSearchProvider, LinkedInSearchProvider, PressReleaseProvider, and
# NewsProvider are the five providers a real run now uses (see
# application/search/README.md's "Federated Search" section and
# run_pipeline.py's `_build_search_collaborators`). CompanyCrawlerProvider
# and PressReleaseProvider need no environment configuration; the other
# three share GOOGLE_SEARCH_API_KEY/GOOGLE_SEARCH_ENGINE_ID (see
# .env.example). This file's BROWSER_SEARCH_* block below is kept only for
# anyone still using BrowserSearchProvider standalone (see
# infrastructure/search/browser/README.md) — it has no effect on
# run_pipeline.py's actual Search Layer wiring.
#
# IMPORTANT — READ BEFORE RELYING ON THIS:
# Google's own robots.txt has, for many years, disallowed /search for
# generic crawlers. BrowserSearchProvider still checks the configured
# target's real, live robots.txt before searching (unchanged, see
# provider.py's _robots_allow_search) — but if it's disallowed, this
# provider now only logs a WARNING and proceeds anyway, rather than
# stopping (see provider.py's module docstring, "WHY robots.txt IS
# CHECKED BUT NO LONGER BLOCKS EXECUTION"): it drives your own real,
# signed-in browser through the same steps you'd take by hand, not an
# automated crawler hitting Google programmatically. robots.txt is a
# voluntary convention, not law — but Google's Terms of Service
# separately restrict automated querying regardless of robots.txt. You
# are solely responsible for confirming you are authorized to do this
# against your chosen target and account before relying on this
# configuration.
#
# Copy this file to .env.local and load it (run_local.py does this
# automatically via python-dotenv; .env.local is gitignored, this
# .env.local.example file is not):
#     cp .env.local.example .env.local
#
# Nothing in this file is hardcoded into Python — every value here is read
# at runtime via BrowserSearchProviderSettings.from_env()
# (infrastructure/search/browser/settings.py). Change these values freely;
# no code changes are needed to point this at a different search engine.
# ============================================================================

# --- Browser Search provider (Search Layer) --------------------------------
# The results-page URL, with a literal "{query}" placeholder.
BROWSER_SEARCH_URL_TEMPLATE=https://www.google.com/search?q={query}

# CSS selectors for one result item, its title text + link, and its
# snippet, on Google's results page. Google's markup — especially its
# snippet class — changes far more often and less predictably than most
# search engines'; div.g (the result container) and a bare "h3" (the
# title) have been comparatively stable for years, which is why those are
# used here rather than one of Google's obfuscated, frequently-rotated
# class names. If BrowserSearchProvider starts returning zero results
# against a real, allowed query, check BROWSER_SEARCH_DEBUG_DIR (below)
# first — it saves the actual page HTML/screenshot every time this
# happens, which is the fastest way to see exactly what changed.
BROWSER_SEARCH_RESULT_SELECTOR=div.g
BROWSER_SEARCH_TITLE_SELECTOR=h3
# The anchor that wraps the h3 title (Playwright's :has() selector) — more
# robust than "the first <a> in the container," since Google sometimes adds
# other links (e.g. a "cached"/site-links row) to the same result block.
BROWSER_SEARCH_URL_SELECTOR=a:has(h3)
BROWSER_SEARCH_SNIPPET_SELECTOR=.VwiC3b

# Maximum result URLs collected per query.
BROWSER_SEARCH_MAX_RESULTS=10

# "false" runs a visible (non-headless) browser — useful the first time you
# run this locally, to actually watch it navigate and confirm the
# selectors above still match, and generally less likely to trigger
# Google's bot detection than headless. Google actively fingerprints
# automated browsers, more so than most search engines — "false" plus a
# real Chrome profile (BROWSER_SEARCH_USER_DATA_DIR, below) is the
# combination this provider is designed around.
BROWSER_SEARCH_HEADLESS=false

# Path to your actual, already-installed Google Chrome executable (not
# Playwright's bundled Chromium — this provider is specifically designed
# to use your real browser). Examples:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
BROWSER_SEARCH_EXECUTABLE_PATH=

# Path to a real Chrome user-data directory — launched via
# launch_persistent_context(), so the resulting session carries that
# profile's cookies, browsing history, and signed-in state. Required (see
# settings.py's user_data_dir docstring for why there's no default).
#
# It's fine (and the simplest setup) to point this at Chrome's actual
# default profile ROOT directory:
#   Windows: C:\Users\<you>\AppData\Local\Google\Chrome\User Data
#   macOS:   ~/Library/Application Support/Google/Chrome
#   Linux:   ~/.config/google-chrome
# — the provider recognizes that exact directory and automatically
# launches against a dedicated "PlaywrightProfile" subdirectory of it
# instead (created on first run), never your actual default profile:
# Chrome itself refuses DevTools remote debugging against its default
# profile at all ("DevTools remote debugging requires a non-default data
# directory"), and this provider never requires handing over your
# everyday browsing session to search. That dedicated subdirectory also
# sidesteps Chrome's "already running" single-instance lock — you do not
# need to close your regular Chrome window first.
#
# If you'd rather choose the dedicated directory yourself (a specific
# name, a different disk, etc.), point this at any other real directory
# and it's used exactly as given.
BROWSER_SEARCH_USER_DATA_DIR=

# Directory a query's rendered page HTML + a screenshot are saved to whenever
# that query's selectors yield zero results (page loaded, but nothing
# matched) — this is what lets you tell "the search engine changed its
# markup" apart from "the search engine served a bot-check/rate-limit page"
# after the fact, without re-running with a debugger attached. Blank
# disables saving.
BROWSER_SEARCH_DEBUG_DIR=browser_search_debug

# --- Development Mode (run_pipeline.py / run_local.py only) ----------------
# When "true", a provider failure that looks like a network/connectivity
# problem (a blocked outbound connection, DNS failure, or an HTTP 403 at
# the connection stage) does NOT count towards that provider's
# consecutive-failure streak, so ProviderHealthTracker's circuit breaker
# never trips from that class of failure alone. A provider that reaches
# the real destination and gets a genuine content-level failure (404, 500,
# a timeout after retries) is tracked exactly as before — Development Mode
# changes nothing about how real website failures are handled. Off by
# default; only affects run_pipeline.py/run_local.py, never
# scripts/run_evaluation.py or the orchestrator's own default behavior.
PIPELINE_DEV_MODE=true

# Where run_local.py / run_pipeline.py write results.xlsx,
# processing_report.json, and logs/, if you don't pass --output-dir.
PIPELINE_OUTPUT_DIR=run_output
